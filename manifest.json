{
  "manifest_version": 3,
  "name": "Bug Bash Capture",
  "version": "0.1.0",
  "description": "Capture a screenshot + description of a bug during a bug-bash session and send it to a configured intake service.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Bug Bash Capture"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "tabs", "storage", "alarms", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
