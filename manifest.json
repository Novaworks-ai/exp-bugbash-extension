{
  "manifest_version": 3,
  "name": "Bug Bash Capture",
  "key": "",
  "version": "0.7.7",
  "description": "Capture a screenshot + description of a bug during a bug-bash session and send it to a configured intake service.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Bug Bash Capture"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/popup.html?panel=1"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "identity",
    "declarativeNetRequest",
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*", "<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
